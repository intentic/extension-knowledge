var SWITCHES = /* @__PURE__ */ new Set([
	"json",
	"help",
	"all"
]);
var parseArgs = (argv) => {
	const positionals = [];
	const flags = /* @__PURE__ */ new Map();
	const push = (name, value) => {
		flags.set(name, [...flags.get(name) ?? [], value]);
	};
	for (let i = 0; i < argv.length; i++) {
		const arg = argv[i] ?? "";
		if (!arg.startsWith("--")) {
			positionals.push(arg);
			continue;
		}
		const [name, inline] = (() => {
			const cut = arg.indexOf("=");
			return cut === -1 ? [arg.slice(2), void 0] : [arg.slice(2, cut), arg.slice(cut + 1)];
		})();
		if (SWITCHES.has(name)) {
			push(name, inline ?? "true");
			continue;
		}
		if (inline !== void 0) {
			push(name, inline);
			continue;
		}
		const next = argv[i + 1];
		if (next === void 0 || next.startsWith("--")) {
			push(name, "");
			continue;
		}
		push(name, next);
		i++;
	}
	return {
		verb: positionals[0] ?? "",
		positionals: positionals.slice(1),
		flags
	};
};
var flag = (args, name) => {
	const last = args.flags.get(name)?.at(-1);
	return last === void 0 || last === "" ? void 0 : last;
};
var flagAll = (args, name) => (args.flags.get(name) ?? []).filter((value) => value !== "");
var has = (args, name) => args.flags.has(name);
var number = (args, name, fallback) => {
	const parsed = Number(flag(args, name));
	return Number.isFinite(parsed) && parsed > 0 ? Math.floor(parsed) : fallback;
};
